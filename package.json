{
  "name": "sanity-plugin-google-photos",
  "version": "1.0.0",
  "description": "Pick photos from Google Photos (including your albums) in Sanity Studio image fields, using the Google Photos Picker API.",
  "keywords": [
    "asset-source",
    "google-photos",
    "image",
    "sanity",
    "sanity-plugin"
  ],
  "license": "MIT",
  "author": "Hanna Alanizi <hannaalanizi@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/ui": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^13.0.16",
    "@sanity/plugin-kit": "^10.1.0",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.21.0",
    "styled-components": "^6.6.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "sanity": "^5 || ^6.0.0-0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Halanizi/sanity-plugin-google-photos.git"
  },
  "bugs": "https://github.com/Halanizi/sanity-plugin-google-photos/issues",
  "homepage": "https://github.com/Halanizi/sanity-plugin-google-photos#readme"
}